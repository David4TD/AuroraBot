# ─── AuroraBot configuration ────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.

# Discord bot token (Discord Developer Portal → Your App → Bot → Reset Token)
DISCORD_TOKEN=your-discord-bot-token-here

# PandaScore API key (https://pandascore.co → Dashboard → API key)
ESPORTS_API_KEY=your-pandascore-api-key-here

# Path to the SQLite database file (inside the container this maps to the volume)
DATABASE_PATH=/appdata/aurorabot.db

# ─── Optional tuning ────────────────────────────────────────────────────────
# Comma-separated Discord guild IDs to sync commands to instantly during dev.
# Leave blank for global command sync (can take up to 1 hour to propagate).
DEV_GUILD_IDS=

# How often (seconds) the alerts loop polls PandaScore for match state changes.
ALERT_POLL_SECONDS=60

# How many minutes before kick-off the "match starting soon" reminder fires.
# The reminder carries the 1️⃣/2️⃣ winner-prediction reactions.
ALERT_LEAD_MINUTES=30

# Only surface top-tier tournaments (scores, alerts, predictions, standings
# and team form). Set to false to include every tier.
TOP_TIER_ONLY=true

# Which PandaScore tier grades count as "Tier 1". Their scale is S>A>B>C>D,
# and it's narrower than the scene's: S is majors only (Worlds, MSI, TI, CS
# Majors, VCT Masters) while the regional leagues — LEC, LCK, LCS, LPL, VCT
# EMEA/NA, ESL Pro League — are graded A. The default covers both.
#   TIERS=s      → majors only
#   TIERS=s,a,b  → also include second-tier circuits
TIERS=s,a

# Port the internal health server listens on (used by Docker HEALTHCHECK).
HEALTH_PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# PandaScore videogame slug overrides (only change if PandaScore renames them).
# Defaults are sensible; CS2 currently lives under the "cs-go" slug on PandaScore.
PANDASCORE_CS_SLUG=cs-go

# ─── Daily schedule digest ──────────────────────────────────────────────────
# Channels subscribed to a tournament get one message listing that day's
# matches, with a dropdown for predicting winners.
# Timezone the "day" is measured in — a named zone, so local midnight stays
# correct across daylight saving. Any IANA name works (e.g. Europe/London).
DIGEST_TZ=Australia/Sydney
# Local hour to post at. 0 = midnight.
DIGEST_HOUR=0
